<?xml version="1.0"?>
<package format="3">

  <name>soil_sampler_bringup</name>
  <version>0.1.0</version>

  <description>
    Launch and configuration files for the robotic soil sampling implement.
  </description>

  <maintainer email="jeppha@mmmi.sdu.dk">Jeppe Hansen</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <exec_depend>soil_sampler_driver</exec_depend>
  <exec_depend>soil_sampler_control</exec_depend>
  <exec_depend>soil_sampler_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
